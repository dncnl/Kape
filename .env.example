# Copy to .env.local and fill in. Never commit real values.

# Stripe sandbox secret key from `stripe sandbox create`.
# Must start with sk_test_ or rk_test_. Live keys are refused.
# Leave empty to run in demo mode (sample data, sleepy Tasa).
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...).
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: returned by `stripe post /v1/webhook_endpoints ...`.
STRIPE_WEBHOOK_SECRET=

# Password for /dashboard when it shows real Stripe data.
# Sample data in demo mode is open to everyone.
DASHBOARD_PASSWORD=

# Optional. A Loom walkthrough linked from the "Payments are napping" card.
LOOM_URL=
